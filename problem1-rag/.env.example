# Problem 1 — RAG. Put these in the repo-root .env (never commit .env).
GEMINI_API_KEY=

# Models (pinned in Phase 0; see evidence/phase0_summary.md)
RAG_EMBED_MODEL=gemini-embedding-2
RAG_EMBED_DIM=768
RAG_GEN_MODEL=gemini-3.1-flash-lite
RAG_JUDGE_MODEL=gemini-3.6-flash

# Chunking / retrieval defaults
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
# Similarity gate for "no relevant context"; calibrated on dev questions in Phase 1c (empty = not yet calibrated)
RAG_MIN_SIMILARITY=

# Paths (relative to problem1-rag/)
RAG_DB_PATH=lancedb
RAG_LOG_PATH=logs/queries.jsonl

# Spend guards: hard cap in USD (paid-tier-equivalent; P1 1.5 + P2 3.5 = project cap $5) and request throttle
BUDGET_USD=1.5
LLM_RPM=15
